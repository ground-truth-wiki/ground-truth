  "ladder": [
    {
      "title": "Chat with a PDF",
      "desc": "Parse, chunk, embed, retrieve and answer with citations. Then break it on purpose with tables and scanned pages.",
      "chapters": [
        "rag-fundamentals",
        "chunking",
        "grounding-citations"
      ]
    },
    {
      "title": "A structured extractor with a review queue",
      "desc": "Pull typed fields from messy documents, validate them against a schema, and route low-confidence items to a human.",
      "chapters": [
        "structured-outputs",
        "document-extraction"
      ]
    },
    {
      "title": "Hybrid search with reranking and a retrieval eval",
      "desc": "BM25 plus vectors, fused with RRF, reranked with a cross-encoder, measured with recall@k and nDCG on a labeled set.",
      "chapters": [
        "hybrid-retrieval",
        "reranking",
        "rag-evaluation"
      ]
    },
    {
      "title": "A tool-using agent from scratch",
      "desc": "The loop in about 100 lines: tools, stop conditions, budgets and a trace you can read. No framework.",
      "chapters": [
        "agent-loop",
        "agent-tools"
      ]
    },
    {
      "title": "An MCP server for a system you use daily",
      "desc": "Expose a real system as tools and resources, test it with the Inspector, and use it from two different hosts.",
      "chapters": [
        "building-mcp-servers",
        "mcp-primitives"
      ]
    },
    {
      "title": "An eval harness with a calibrated judge",
      "desc": "Error analysis on 100 traces, a binary rubric, a judge checked against your labels, and confidence intervals on the result.",
      "chapters": [
        "error-analysis",
        "llm-as-judge",
        "eval-statistics"
      ]
    },
    {
      "title": "A sandboxed coding or research agent",
      "desc": "Run code in a sandbox with egress limits, trace every step, and enforce token and time budgets.",
      "chapters": [
        "sandboxes",
        "observability-tracing",
        "guardrails-control"
      ]
    },
    {
      "title": "Self-host a model for one workload",
      "desc": "Serve a quantized open model, measure TTFT and throughput, and find the break-even against an API.",
      "chapters": [
        "serving-engines",
        "quantization",
        "cost-engineering"
      ]
    },
    {
      "title": "A multi-agent system you can defend",
      "desc": "Orchestrator and workers with evals, tracing, a cost budget and a red-team suite, plus a written case for why it needs to be multi-agent.",
      "chapters": [
        "multi-agent",
        "evaluating-agents",
        "red-teaming"
      ]
    }
  ]
