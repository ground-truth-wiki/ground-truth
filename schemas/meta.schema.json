{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta.schema.json",
  "title": "data/meta.json",
  "description": "Site name, version and dates shown in the footer. title must equal name in site.config.json.",
  "type": "object",
  "required": ["title", "version", "updated", "cutoff", "verified"],
  "additionalProperties": false,
  "properties": {
    "title": { "$ref": "#/$defs/text" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "cutoff": { "$ref": "#/$defs/text" },
    "verified": { "$ref": "#/$defs/text" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "text": { "type": "string", "minLength": 1 } }
}
