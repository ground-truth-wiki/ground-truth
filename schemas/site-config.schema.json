{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-config.schema.json",
  "title": "site.config.json",
  "description": "The project's identity. Every script and page reads it from here.",
  "type": "object",
  "required": ["name", "shortName", "description", "siteUrl", "repository", "license"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 200 },
    "siteUrl": { "type": "string", "pattern": "^https://[^/]+$", "description": "The site address without a trailing slash. A host on .example means the address is not decided yet." },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
    "license": {
      "type": "object",
      "required": ["content", "code"],
      "additionalProperties": false,
      "properties": { "content": { "type": "string" }, "code": { "type": "string" } }
    }
  }
}
