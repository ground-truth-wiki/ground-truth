{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "changelog.schema.json",
  "title": "data/changelog.json",
  "description": "One entry per version: date, chapters touched and a one-line summary.",
  "type": "object",
  "required": ["entries"],
  "additionalProperties": false,
  "properties": {
    "entries": { "type": "array", "items": { "type": "object", "required": ["version", "date", "chapters", "summary"], "additionalProperties": false,
      "properties": { "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }, "chapters": { "$ref": "#/$defs/ids" }, "summary": { "$ref": "#/$defs/text" } } } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "text": { "type": "string", "minLength": 1 } }
}
