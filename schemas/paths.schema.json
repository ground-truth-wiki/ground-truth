{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paths.schema.json",
  "title": "data/paths.json",
  "description": "Learning paths and the project ladder.",
  "type": "object",
  "required": ["paths", "ladder"],
  "additionalProperties": false,
  "properties": {
    "paths": { "type": "array", "items": { "type": "object", "required": ["id", "title", "blurb", "steps"], "additionalProperties": false,
      "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "$ref": "#/$defs/text" }, "blurb": { "$ref": "#/$defs/text" }, "steps": { "$ref": "#/$defs/ids" },
        "weeks": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "The week of each step, for paths with a schedule." } } } },
    "ladder": { "type": "array", "items": { "type": "object", "required": ["title", "desc", "chapters"], "additionalProperties": false,
      "properties": { "title": { "$ref": "#/$defs/text" }, "desc": { "$ref": "#/$defs/text" }, "chapters": { "$ref": "#/$defs/ids" } } } }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "text": { "type": "string", "minLength": 1 } }
}
